      <aliases enabled='yes' />
      <column caption='Profit Margin %' datatype='real' name='[Calculation_1493440526139392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_1493440526290945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Order Date])' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_1493440526417922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;quarter&apos;,[Order Date])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_1493440526512131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[Order Date])' />
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_1493440530907141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Select KPI]=&quot;Sales&quot; THEN&#13;&#10;SUM([Sales])&#13;&#10;&#13;&#10;ELSE&#13;&#10;SUM([Profit])&#13;&#10;&#13;&#10;END' />
      </column>
