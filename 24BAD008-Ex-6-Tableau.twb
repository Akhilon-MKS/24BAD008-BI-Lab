      <aliases enabled='yes' />
      <column caption='Total Sales' datatype='real' name='[Calculation_1605040965812224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='Total Sales Target' datatype='integer' name='[Calculation_1605040965980161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales Target])' />
      </column>
      <column caption='Target Achievement %' datatype='real' name='[Calculation_1605040966111234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) / SUM([Sales Target])) * 100' />
      </column>
      <column caption='Sales vs Target Variance' datatype='real' name='[Calculation_1605040966193155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) - SUM([Sales Target])' />
